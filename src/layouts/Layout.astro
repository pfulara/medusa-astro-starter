---
import { ClientRouter } from "astro:transitions"
import { getMedusaConfig } from "../lib/config"

interface Props {
  title?: string
  description?: string
}

const {
  title = "Atelier — współczesne przedmioty",
  description = "Starannie wybrane przedmioty do domu i codziennego życia.",
} = Astro.props
const { backendUrl: medusaBackendUrl, publishableKey: medusaPublishableKey = "" } = getMedusaConfig()
---

<!doctype html>
<html lang="pl" data-medusa-backend-url={medusaBackendUrl} data-medusa-publishable-key={medusaPublishableKey}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #20221f;
    background: #f5f3ee;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { min-width: 320px; min-height: 100vh; margin: 0; }
  button, a { font: inherit; }
  img { display: block; max-width: 100%; }
  ::selection { color: #fff; background: #35503a; }

  @keyframes page-out {
    to { opacity: 0; transform: translateY(-10px); }
  }

  @keyframes page-in {
    from { opacity: 0; transform: translateY(18px); }
  }

  ::view-transition-old(root) {
    animation: 220ms cubic-bezier(0.4, 0, 1, 1) both page-out;
  }

  ::view-transition-new(root) {
    animation: 480ms cubic-bezier(0.22, 1, 0.36, 1) both page-in;
  }

  ::view-transition-group(*) {
    animation-duration: 620ms;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    ::view-transition-old(root),
    ::view-transition-new(root),
    ::view-transition-group(*) {
      animation-duration: 1ms;
    }
  }
</style>
