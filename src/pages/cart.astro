---
import CartLink from "../components/CartLink.astro"
import AccountLink from "../components/AccountLink.astro"
import Layout from "../layouts/Layout.astro"
---

<Layout title="Koszyk — Atelier" description="Zawartość Twojego koszyka w Atelier.">
  <header class="cart-header">
    <a class="back-link" href="/"><span aria-hidden="true">←</span> Kontynuuj zakupy</a>
    <a class="brand" href="/">Atelier</a>
    <div class="header-actions"><AccountLink /><CartLink /></div>
  </header>

  <main class="cart-page">
    <div class="page-heading">
      <p class="eyebrow">Twoje zamówienie</p>
      <h1>Koszyk</h1>
    </div>

    <section class="cart-content" data-cart-content aria-live="polite">
      <p class="cart-state" data-cart-state>Ładowanie koszyka…</p>
      <div class="cart-items" data-cart-items></div>
      <aside class="summary" data-cart-summary hidden>
        <h2>Podsumowanie</h2>
        <div class="summary-line"><span>Produkty</span><strong data-cart-total></strong></div>
        <div class="summary-line"><span>Dostawa</span><span>Obliczana przy kasie</span></div>
        <a class="checkout-link" href="/checkout">Przejdź do kasy <span aria-hidden="true">→</span></a>
        <p>Płatność i dostawa zostaną skonfigurowane w kolejnym kroku.</p>
      </aside>
      <div class="empty-cart" data-empty-cart hidden>
        <p class="empty-mark" aria-hidden="true">A</p>
        <h2>Twój koszyk jest pusty</h2>
        <p>Wybierz przedmioty, które zostaną z Tobą na dłużej.</p>
        <a href="/#products">Zobacz kolekcję <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>

  <script>
    import type { HttpTypes } from "@medusajs/types"
    import { formatCartPrice, removeCartItem, retrieveCart, updateCartItem } from "../lib/cart"

    function setupCartPage() {
      const itemsRoot = document.querySelector<HTMLElement>("[data-cart-items]")
      const summary = document.querySelector<HTMLElement>("[data-cart-summary]")
      const empty = document.querySelector<HTMLElement>("[data-empty-cart]")
      const total = document.querySelector<HTMLElement>("[data-cart-total]")
      const state = document.querySelector<HTMLElement>("[data-cart-state]")
      if (!itemsRoot || !summary || !empty || !total || !state) return

      const render = (cart: HttpTypes.StoreCart | null) => {
        const items = cart?.items || []
        itemsRoot.replaceChildren(...items.map((item) => createCartItem(item, cart!)))
        const hasItems = items.length > 0
        summary.hidden = !hasItems
        empty.hidden = hasItems
        state.hidden = true
        total.textContent = cart ? formatCartPrice(cart.item_total, cart.currency_code) : ""
      }

      const createCartItem = (item: HttpTypes.StoreCartLineItem, cart: HttpTypes.StoreCart) => {
        const article = document.createElement("article")
        article.className = "cart-item"
        const handle = item.product_handle || item.product?.handle || ""
        const title = item.product_title || item.title
        const variantDetails = formatVariantDetails(item)
        article.innerHTML = `
          <a class="item-image" href="/products/${encodeURIComponent(handle)}">
            ${item.thumbnail ? `<img src="${escapeHtml(item.thumbnail)}" alt="${escapeHtml(title)}" loading="lazy" />` : `<span>${escapeHtml(title.charAt(0))}</span>`}
          </a>
          <div class="item-details">
            <p class="item-label">Atelier</p>
            <h2><a href="/products/${encodeURIComponent(handle)}">${escapeHtml(title)}</a></h2>
            <p class="item-variant">${escapeHtml(variantDetails)}</p>
            <button class="remove" type="button">Usuń</button>
          </div>
          <div class="quantity" aria-label="Ilość produktu ${escapeHtml(title)}">
            <button type="button" data-action="decrease" aria-label="Zmniejsz ilość">−</button>
            <span>${item.quantity}</span>
            <button type="button" data-action="increase" aria-label="Zwiększ ilość">+</button>
          </div>
          <p class="item-price">${formatCartPrice(item.total ?? item.unit_price * item.quantity, cart.currency_code)}</p>
        `

        const setPending = (pending: boolean) => {
          article.classList.toggle("is-pending", pending)
          article.querySelectorAll<HTMLButtonElement>("button").forEach((button) => { button.disabled = pending })
        }

        const mutate = async (operation: () => Promise<HttpTypes.StoreCart>) => {
          setPending(true)
          state.hidden = true
          try {
            render(await operation())
          } catch (error) {
            setPending(false)
            state.textContent = error instanceof Error ? error.message : "Nie udało się zaktualizować koszyka."
            state.classList.add("is-error")
            state.hidden = false
          }
        }

        article.querySelector('[data-action="decrease"]')?.addEventListener("click", () => {
          if (item.quantity === 1) mutate(() => removeCartItem(item.id))
          else mutate(() => updateCartItem(item.id, item.quantity - 1))
        })
        article.querySelector('[data-action="increase"]')?.addEventListener("click", () => mutate(() => updateCartItem(item.id, item.quantity + 1)))
        article.querySelector(".remove")?.addEventListener("click", () => mutate(() => removeCartItem(item.id)))
        return article
      }

      const formatVariantDetails = (item: HttpTypes.StoreCartLineItem) => {
        const values = Object.values(item.variant_option_values || {}).filter((value): value is string => typeof value === "string")
        return values.join(" / ") || item.variant_title || item.subtitle || "Wariant domyślny"
      }

      const escapeHtml = (value: string) => value.replace(/[&<>'"]/g, (character) => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;",
      })[character] || character)

      retrieveCart()
        .then(render)
        .catch((error) => {
          state.textContent = error instanceof Error ? error.message : "Nie udało się pobrać koszyka."
          state.classList.add("is-error")
        })
    }

    document.addEventListener("astro:page-load", setupCartPage)
    setupCartPage()
  </script>
</Layout>

<style>
  .cart-header, .cart-page { width: min(1240px, calc(100% - 64px)); margin-inline: auto; }
  .cart-header { min-height: 82px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; border-bottom: 1px solid rgba(32,34,31,.13); }
  .back-link, .brand { color: #20221f; text-decoration: none; }
  .back-link { font-size: .78rem; font-weight: 700; }
  .back-link span { margin-right: 8px; }
  .brand { font: 700 1.35rem Georgia,"Times New Roman",serif; }
  .header-actions { justify-self: end; display: flex; align-items: center; }
  .cart-page { padding: 76px 0 120px; }
  .page-heading { padding-bottom: 44px; border-bottom: 1px solid rgba(32,34,31,.13); }
  .eyebrow { margin: 0 0 14px; color: #777a73; font-size: .68rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  h1 { margin: 0; font: 400 clamp(3.8rem,7vw,7rem)/.9 Georgia,"Times New Roman",serif; letter-spacing: -.055em; }
  .cart-content { display: grid; grid-template-columns: minmax(0,1fr) 360px; gap: 72px; padding-top: 42px; }
  .cart-items { min-width: 0; }
  .cart-state { grid-column: 1 / -1; margin: 0; color: #6d7069; }
  .cart-state.is-error { padding: 16px; color: #934a3d; background: #eee0dc; }
  :global(.cart-item) { display: grid; grid-template-columns: 150px minmax(0,1fr) auto 110px; gap: 24px; align-items: center; padding: 0 0 28px; margin-bottom: 28px; border-bottom: 1px solid #d6d1c7; }
  :global(.cart-item.is-pending) { opacity: .55; }
  :global(.item-image) { aspect-ratio: .82; display: grid; place-items: center; overflow: hidden; color: rgba(53,80,58,.28); background: #e5e0d6; font: 4rem Georgia,serif; text-decoration: none; }
  :global(.item-image img) { width: 100%; height: 100%; object-fit: cover; }
  :global(.item-label) { margin: 0 0 7px; color: #858880; font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; }
  :global(.item-details h2) { margin: 0; font: 400 1.5rem Georgia,"Times New Roman",serif; }
  :global(.item-details h2 a) { color: inherit; text-decoration: none; }
  :global(.item-variant) { margin: 9px 0 20px; color: #73766f; font-size: .75rem; }
  :global(.remove) { padding: 0; border: 0; border-bottom: 1px solid; color: #6e716b; background: none; cursor: pointer; font-size: .7rem; }
  :global(.quantity) { display: flex; align-items: center; border: 1px solid #cbc6ba; }
  :global(.quantity button) { width: 44px; height: 44px; border: 0; background: none; cursor: pointer; }
  :global(.quantity span) { min-width: 25px; text-align: center; font-size: .78rem; }
  :global(.item-price) { margin: 0; text-align: right; font-size: .8rem; }
  .summary { position: sticky; top: 32px; align-self: start; padding: 30px; background: #ebe7de; }
  .summary h2 { margin: 0 0 28px; font: 400 2rem Georgia,"Times New Roman",serif; }
  .summary-line { display: flex; justify-content: space-between; gap: 20px; padding: 15px 0; border-top: 1px solid #d2ccbf; color: #62655f; font-size: .76rem; }
  .summary-line strong { color: #20221f; }
  .checkout-link { width: 100%; display: flex; justify-content: space-between; margin-top: 18px; padding: 17px 18px; color: #fff; background: #35503a; font-size: .78rem; font-weight: 700; text-decoration: none; transition: background 180ms ease; }
  .checkout-link:hover { background: #263e2b; }
  .summary p { margin: 16px 0 0; color: #777a73; font-size: .68rem; line-height: 1.5; }
  .empty-cart { grid-column: 1 / -1; padding: 70px 20px; text-align: center; }
  .empty-mark { width: 56px; height: 56px; display: grid; place-items: center; margin: 0 auto 24px; border-radius: 50%; color: #f5f3ee; background: #35503a; font: 1.3rem Georgia,serif; }
  .empty-cart h2 { margin: 0; font: 400 2.6rem Georgia,"Times New Roman",serif; }
  .empty-cart > p:not(.empty-mark) { color: #6d7069; }
  .empty-cart a { display: inline-flex; gap: 36px; margin-top: 18px; padding: 15px 19px; color: #fff; background: #35503a; text-decoration: none; font-size: .78rem; font-weight: 700; }
  [hidden] { display: none !important; }
  @media (max-width: 900px) { .cart-content { grid-template-columns: 1fr; gap: 32px; } .summary { position: static; } }
  @media (max-width: 650px) { .cart-header, .cart-page { width: calc(100% - 32px); } .back-link { font-size: 0; } .back-link span { font-size: 1rem; } .cart-page { padding-top: 52px; } :global(.cart-item) { grid-template-columns: 96px 1fr auto; gap: 16px; align-items: start; } :global(.quantity) { grid-column: 2; width: max-content; } :global(.item-price) { grid-column: 3; grid-row: 2; align-self: center; } }
</style>
