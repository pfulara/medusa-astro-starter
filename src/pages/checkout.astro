---
import Layout from "../layouts/Layout.astro"
import type { HttpTypes } from "@medusajs/types"
import { retrieveCustomer } from "../lib/auth"

const customerToken = await Astro.session?.get("customerToken")
let customer: HttpTypes.StoreCustomer | undefined
if (customerToken) {
  try { customer = await retrieveCustomer(customerToken) }
  catch { Astro.session?.destroy() }
}
const isLoggedIn = Boolean(customer)
const shippingAddress = customer?.addresses?.find((address) => address.id === customer?.default_shipping_address_id)
  || customer?.addresses?.[0]
const checkoutDefaults = {
  email: customer?.email || "",
  firstName: shippingAddress?.first_name || customer?.first_name || "",
  lastName: shippingAddress?.last_name || customer?.last_name || "",
  phone: shippingAddress?.phone || customer?.phone || "",
  address1: shippingAddress?.address_1 || "",
  company: shippingAddress?.company || customer?.company_name || "",
  postalCode: shippingAddress?.postal_code || "",
  city: shippingAddress?.city || "",
  countryCode: shippingAddress?.country_code?.toLowerCase() || "",
}
---

<Layout title="Kasa — Atelier" description="Dane dostawy, wysyłka i płatność za zamówienie w Atelier.">
  <header class="checkout-header">
    <a class="back-link" href="/cart"><span aria-hidden="true">←</span> Wróć do koszyka</a>
    <a class="brand" href="/">Atelier</a>
    <p class="secure-label"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V7a5 5 0 0 1 10 0v3m-11 0h12v10H6z"/></svg> Bezpieczne zakupy</p>
  </header>

  <main class="checkout-page" data-customer-authenticated={String(isLoggedIn)}>
    <div class="page-heading">
      <p class="eyebrow">Finalizacja zamówienia</p>
      <h1>Kasa</h1>
      <p>Uzupełnij dane, wybierz dostawę i sposób płatności.</p>
    </div>

    {isLoggedIn ? (
      <section class="checkout-identity is-account" aria-label="Sposób zakupu">
        <div class="identity-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5"/><path d="M5.5 20c.6-3.9 2.9-5.8 6.5-5.8s5.9 1.9 6.5 5.8"/></svg></div>
        <div><p class="identity-label">Kupujesz jako klient</p><strong>{customer?.first_name || customer?.email}</strong><span>{customer?.email}</span></div>
        <a href="/account">Przejdź do konta</a>
      </section>
    ) : (
      <section class="checkout-choice" aria-labelledby="checkout-choice-title">
        <div class="choice-heading"><p class="eyebrow">Sposób zakupu</p><h2 id="checkout-choice-title">Jak chcesz kontynuować?</h2></div>
        <div class="checkout-choice-grid">
          <article class="checkout-choice-card is-selected">
            <span class="choice-check" aria-hidden="true"></span>
            <div><strong>Kup jako gość</strong><p>Kontynuuj bez zakładania konta.</p></div>
          </article>
          <a class="checkout-choice-card" href="/account/login?next=/checkout">
            <span class="choice-arrow" aria-hidden="true">→</span>
            <div><strong>Zaloguj się</strong><p>Użyj zapisanych danych i zachowaj zamówienie w historii.</p></div>
          </a>
        </div>
      </section>
    )}

    <div class="checkout-state" data-checkout-state aria-live="polite">Ładowanie zamówienia…</div>

    <div class="checkout-layout" data-checkout-layout hidden>
      <form class="checkout-form" data-checkout-form novalidate>
        <section class="checkout-section" aria-labelledby="contact-title">
          <div class="section-number">01</div>
          <div class="section-content">
            <div class="section-heading"><div><p class="eyebrow">Kontakt</p><h2 id="contact-title">Dane odbiorcy</h2></div><span>Wymagane pola *</span></div>
            <div class="field-grid">
              <label class="full-field">E-mail *<input type="email" name="email" autocomplete="email" required placeholder="anna@przyklad.pl" value={checkoutDefaults.email} /></label>
              <label>Imię *<input type="text" name="first_name" autocomplete="given-name" required value={checkoutDefaults.firstName} /></label>
              <label>Nazwisko *<input type="text" name="last_name" autocomplete="family-name" required value={checkoutDefaults.lastName} /></label>
              <label class="full-field">Telefon *<input type="tel" name="phone" autocomplete="tel" required value={checkoutDefaults.phone} /></label>
            </div>
          </div>
        </section>

        <section class="checkout-section" aria-labelledby="address-title">
          <div class="section-number">02</div>
          <div class="section-content">
            <div class="section-heading"><div><p class="eyebrow">Dokąd wysyłamy</p><h2 id="address-title">Adres dostawy</h2></div></div>
            <div class="field-grid">
              <label class="full-field">Ulica i numer *<input type="text" name="address_1" autocomplete="address-line1" required value={checkoutDefaults.address1} /></label>
              <label class="full-field">Firma <input type="text" name="company" autocomplete="organization" value={checkoutDefaults.company} /></label>
              <label>Kod pocztowy *<input type="text" name="postal_code" autocomplete="postal-code" inputmode="numeric" pattern="[0-9]{2}-?[0-9]{3}" required placeholder="00-000" value={checkoutDefaults.postalCode} /></label>
              <label>Miasto *<input type="text" name="city" autocomplete="address-level2" required value={checkoutDefaults.city} /></label>
              <label class="full-field">Kraj *<select name="country_code" autocomplete="country" required disabled data-default-country={checkoutDefaults.countryCode}><option value="">Ładowanie obsługiwanych krajów…</option></select></label>
            </div>
            <label class="checkbox-field"><input type="checkbox" name="billing_same" checked /> <span>Adres rozliczeniowy jest taki sam jak adres dostawy</span></label>
            <button class="secondary-button" type="button" data-save-address disabled>Zapisz dane i pokaż dostawę <span aria-hidden="true">→</span></button>
          </div>
        </section>

        <section class="checkout-section is-locked" aria-labelledby="delivery-title" data-delivery-section>
          <div class="section-number">03</div>
          <div class="section-content">
            <div class="section-heading"><div><p class="eyebrow">Sposób doręczenia</p><h2 id="delivery-title">Dostawa</h2></div></div>
            <div class="options-list" data-shipping-options><p class="muted">Najpierw zapisz adres dostawy.</p></div>
          </div>
        </section>

        <section class="checkout-section is-locked" aria-labelledby="payment-title" data-payment-section>
          <div class="section-number">04</div>
          <div class="section-content">
            <div class="section-heading"><div><p class="eyebrow">Bezpieczna transakcja</p><h2 id="payment-title">Płatność</h2></div></div>
            <div class="options-list" data-payment-options><p class="muted">Wybierz najpierw sposób dostawy.</p></div>
          </div>
        </section>

        <div class="form-error" data-form-error role="alert" hidden></div>
        <button class="place-order" type="submit" data-place-order disabled>Zamawiam i płacę <span aria-hidden="true">→</span></button>
        <p class="terms">Składając zamówienie, potwierdzasz obowiązek zapłaty i akceptujesz regulamin sklepu.</p>
      </form>

      <aside class="order-summary">
        <p class="eyebrow">Twoje zamówienie</p><h2>Podsumowanie</h2>
        <div class="summary-items" data-summary-items></div>
        <div class="summary-totals">
          <div><span>Produkty</span><span data-subtotal></span></div>
          <div><span>Dostawa</span><span data-shipping-total>Do wyboru</span></div>
          <div class="grand-total"><strong>Razem</strong><strong data-total></strong></div>
        </div>
        <div class="trust-note"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.6 2.9 8.4 7 10 4.1-1.6 7-5.4 7-10V6z"/></svg><p><strong>Bezpieczna płatność</strong><br />Twoje dane są szyfrowane i chronione.</p></div>
      </aside>
    </div>

    <section class="empty-checkout" data-empty-checkout hidden><h2>Koszyk jest pusty</h2><p>Dodaj produkty, zanim przejdziesz do kasy.</p><a href="/#products">Zobacz kolekcję <span aria-hidden="true">→</span></a></section>
    <section class="order-success" data-order-success hidden aria-live="polite"><p class="success-mark">A</p><p class="eyebrow">Zamówienie przyjęte</p><h2>Dziękujemy.</h2><p>Numer zamówienia: <strong data-order-number></strong></p><p>Potwierdzenie wyślemy na podany adres e-mail.</p><a href="/">Wróć na stronę główną <span aria-hidden="true">→</span></a></section>
  </main>

  <script>
    import type { HttpTypes } from "@medusajs/types"
    import { CART_STORAGE_KEY, formatCartPrice, getCartSdk, retrieveCart } from "../lib/cart"

    function setupCheckout() {
      const root = document.querySelector<HTMLElement>("[data-checkout-layout]")
      const state = document.querySelector<HTMLElement>("[data-checkout-state]")
      const empty = document.querySelector<HTMLElement>("[data-empty-checkout]")
      const form = document.querySelector<HTMLFormElement>("[data-checkout-form]")
      if (!root || !state || !empty || !form) return
      const sdk = getCartSdk()
      let cart: HttpTypes.StoreCart | null = null
      let shippingOptionId = ""
      let paymentProviderId = ""
      let busy = false
      let cartTransferred = false

      const errorBox = form.querySelector<HTMLElement>("[data-form-error]")!
      const submit = form.querySelector<HTMLButtonElement>("[data-place-order]")!
      const shippingRoot = form.querySelector<HTMLElement>("[data-shipping-options]")!
      const paymentRoot = form.querySelector<HTMLElement>("[data-payment-options]")!
      const deliverySection = form.querySelector<HTMLElement>("[data-delivery-section]")!
      const paymentSection = form.querySelector<HTMLElement>("[data-payment-section]")!
      const countrySelect = form.elements.namedItem("country_code") as HTMLSelectElement
      const saveAddressButton = form.querySelector<HTMLButtonElement>("[data-save-address]")!
      const customerAuthenticated = document.querySelector<HTMLElement>("[data-customer-authenticated]")?.dataset.customerAuthenticated === "true"

      const transferCart = async () => {
        if (!customerAuthenticated || cartTransferred || !cart) return
        const data = new FormData()
        data.set("cart_id", cart.id)
        const response = await fetch("/api/account/cart", { method: "POST", body: data })
        if (!response.ok) throw new Error("Nie udało się przypisać koszyka do Twojego konta.")
        cartTransferred = true
      }

      const setError = (message = "") => { errorBox.textContent = message; errorBox.hidden = !message }
      const setBusy = (value: boolean) => { busy = value; form.classList.toggle("is-busy", value); form.querySelectorAll<HTMLButtonElement>("button").forEach((button) => { button.disabled = value || (button === submit && (!shippingOptionId || !paymentProviderId)) }) }
      const format = (amount: number) => formatCartPrice(amount, cart?.currency_code || "pln")

      const renderSummary = () => {
        if (!cart) return
        const itemsRoot = document.querySelector<HTMLElement>("[data-summary-items]")!
        itemsRoot.replaceChildren(...(cart.items || []).map((item) => {
          const row = document.createElement("article")
          row.className = "summary-item"
          row.innerHTML = `${item.thumbnail ? `<img src="${escapeHtml(item.thumbnail)}" alt="" />` : `<span class="summary-placeholder">${escapeHtml((item.product_title || item.title).charAt(0))}</span>`}<div><strong>${escapeHtml(item.product_title || item.title)}</strong><span>${item.quantity} × ${format(item.unit_price)}</span></div><b>${format(item.total ?? item.unit_price * item.quantity)}</b>`
          return row
        }))
        document.querySelector<HTMLElement>("[data-subtotal]")!.textContent = format(cart.item_total)
        document.querySelector<HTMLElement>("[data-shipping-total]")!.textContent = cart.shipping_total ? format(cart.shipping_total) : "Do wyboru"
        document.querySelector<HTMLElement>("[data-total]")!.textContent = format(cart.total)
      }

      const loadRegionCountries = async () => {
        if (!cart?.region_id) throw new Error("Koszyk nie ma przypisanego regionu dostawy.")
        const { region } = await sdk.store.region.retrieve(cart.region_id, { fields: "id,*countries" })
        const names = new Intl.DisplayNames(["pl"], { type: "region" })
        const countries = (region.countries || [])
          .filter((country): country is typeof country & { iso_2: string } => Boolean(country.iso_2))
          .map((country) => ({
            code: country.iso_2.toLowerCase(),
            label: names.of(country.iso_2.toUpperCase()) || country.display_name || country.name || country.iso_2.toUpperCase(),
          }))
          .sort((first, second) => first.label.localeCompare(second.label, "pl"))

        countrySelect.replaceChildren(...countries.map(({ code, label }) => {
          const option = document.createElement("option")
          option.value = code
          option.textContent = label
          return option
        }))

        if (!countries.length) {
          countrySelect.innerHTML = `<option value="">Brak obsługiwanych krajów</option>`
          throw new Error("Region koszyka nie ma skonfigurowanych obsługiwanych krajów.")
        }

        const currentCountry = cart.shipping_address?.country_code?.toLowerCase() || countrySelect.dataset.defaultCountry
        if (currentCountry && countries.some(({ code }) => code === currentCountry)) countrySelect.value = currentCountry
        countrySelect.disabled = false
        saveAddressButton.disabled = false
      }

      const loadPaymentProviders = async () => {
        if (!cart) return
        if (!cart.region_id) throw new Error("Koszyk nie ma przypisanego regionu płatności.")
        paymentRoot.innerHTML = `<p class="muted">Ładowanie metod płatności…</p>`
        const { payment_providers } = await sdk.store.payment.listPaymentProviders({ region_id: cart.region_id })
        paymentRoot.replaceChildren(...payment_providers.map((provider) => createOption("payment", provider.id, paymentLabel(provider.id), paymentDescription(provider.id), "")))
        if (!payment_providers.length) paymentRoot.innerHTML = `<p class="option-error">Brak metod płatności dla tego regionu.</p>`
      }

      const createOption = (name: string, value: string, label: string, description: string, price: string) => {
        const option = document.createElement("label")
        option.className = "choice"
        option.innerHTML = `<input type="radio" name="${name}" value="${escapeHtml(value)}" /><span class="radio-mark"></span><span class="choice-copy"><strong>${escapeHtml(label)}</strong><small>${escapeHtml(description)}</small></span><b>${escapeHtml(price)}</b>`
        option.querySelector("input")?.addEventListener("change", async () => {
          if (name === "shipping") {
            shippingOptionId = value
            setBusy(true); setError()
            try {
              const result = await sdk.store.cart.addShippingMethod(cart!.id, { option_id: value })
              cart = result.cart; renderSummary(); paymentSection.classList.remove("is-locked")
            } catch (error) { shippingOptionId = ""; setError(getMessage(error, "Nie udało się wybrać dostawy.")) }
            finally { setBusy(false) }
          } else { paymentProviderId = value; submit.disabled = !shippingOptionId }
        })
        return option
      }

      form.querySelector<HTMLButtonElement>("[data-save-address]")?.addEventListener("click", async () => {
        if (!form.reportValidity() || !cart || busy) return
        const data = new FormData(form)
        setBusy(true); setError()
        try {
          const address = { first_name: String(data.get("first_name")), last_name: String(data.get("last_name")), phone: String(data.get("phone")), address_1: String(data.get("address_1")), company: String(data.get("company") || ""), postal_code: String(data.get("postal_code")), city: String(data.get("city")), country_code: String(data.get("country_code")) }
          const result = await sdk.store.cart.update(cart.id, { email: String(data.get("email")), shipping_address: address, ...(data.get("billing_same") ? { billing_address: address } : {}) })
          cart = result.cart; renderSummary()
          shippingRoot.innerHTML = `<p class="muted">Ładowanie sposobów dostawy…</p>`
          const { shipping_options } = await sdk.store.fulfillment.listCartOptions({ cart_id: cart.id })
          shippingRoot.replaceChildren(...shipping_options.filter((option) => !option.insufficient_inventory).map((option) => createOption("shipping", option.id, option.name, option.type?.description || "Dostawa na wskazany adres", format(option.amount))))
          if (!shipping_options.length) shippingRoot.innerHTML = `<p class="option-error">Brak dostępnych metod dostawy dla podanego adresu.</p>`
          deliverySection.classList.remove("is-locked")
          await loadPaymentProviders()
          deliverySection.scrollIntoView({ behavior: "smooth", block: "center" })
        } catch (error) { setError(getMessage(error, "Nie udało się zapisać danych dostawy.")) }
        finally { setBusy(false) }
      })

      form.addEventListener("submit", async (event) => {
        event.preventDefault()
        if (!cart || !shippingOptionId || !paymentProviderId || busy) return
        setBusy(true); setError()
        try {
          await transferCart()
          await sdk.store.payment.initiatePaymentSession(cart, { provider_id: paymentProviderId })
          const result = await sdk.store.cart.complete(cart.id)
          if (result.type === "cart") throw new Error(result.error?.message || "Nie udało się złożyć zamówienia.")
          localStorage.removeItem(CART_STORAGE_KEY)
          root.hidden = true
          document.querySelector<HTMLElement>("[data-order-success]")!.hidden = false
          document.querySelector<HTMLElement>("[data-order-number]")!.textContent = String(result.order.display_id || result.order.id)
          window.dispatchEvent(new CustomEvent("atelier:cart-change", { detail: null }))
          window.scrollTo({ top: 0, behavior: "smooth" })
        } catch (error) { setError(getMessage(error, "Nie udało się złożyć zamówienia.")); setBusy(false) }
      })

      retrieveCart().then(async (loadedCart) => {
        state.hidden = true
        if (!loadedCart?.items?.length) { empty.hidden = false; return }
        cart = loadedCart; root.hidden = false; renderSummary()
        try { await transferCart() } catch (error) { setError(getMessage(error, "Nie udało się przypisać koszyka do konta.")) }
        if (cart.email && !customerAuthenticated) (form.elements.namedItem("email") as HTMLInputElement).value = cart.email
        try {
          await loadRegionCountries()
        } catch (error) {
          setError(getMessage(error, "Nie udało się pobrać obsługiwanych krajów."))
          countrySelect.disabled = true
          saveAddressButton.disabled = true
        }
      }).catch((error) => { state.textContent = getMessage(error, "Nie udało się pobrać zamówienia."); state.classList.add("is-error") })
    }

    const paymentLabel = (id: string) => id.includes("stripe") ? "Karta płatnicza" : id.includes("paypal") ? "PayPal" : id.includes("manual") ? "Przelew tradycyjny" : id.replace(/^pp_/, "").replaceAll("_", " ")
    const paymentDescription = (id: string) => id.includes("manual") ? "Dane do przelewu otrzymasz e-mailem" : "Bezpieczna płatność obsługiwana przez operatora"
    const getMessage = (error: unknown, fallback: string) => error instanceof Error ? error.message : fallback
    const escapeHtml = (value: string) => value.replace(/[&<>'"]/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" })[character] || character)
    document.addEventListener("astro:page-load", setupCheckout)
    setupCheckout()
  </script>
</Layout>

<style>
