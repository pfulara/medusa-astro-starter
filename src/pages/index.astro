---
import Layout from "../layouts/Layout.astro"
import SiteHeader from "../components/SiteHeader.astro"
import { formatProductPrice, getStorefrontData, type Product, type ProductCategory } from "../lib/medusa"

let categories: ProductCategory[] = []
let products: Product[] = []
let loadError = ""

try {
  const data = await getStorefrontData(4)
  categories = data.categories
  products = data.products
} catch (error) {
  loadError = error instanceof Error ? error.message : "Nie udało się pobrać danych ze sklepu."
}
---

<Layout>
  <SiteHeader categories={categories} />

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Kolekcja / 2026</p>
        <h1 id="hero-title">Mniej rzeczy.<br /><em>Więcej znaczenia.</em></h1>
        <p class="hero-description">
          Przedmioty stworzone, by zostać z Tobą na dłużej. Proste formy,
          szlachetne materiały i codzienna funkcjonalność.
        </p>
        <a class="primary-button" href="#products">Poznaj kolekcję <span aria-hidden="true">→</span></a>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div class="sun"></div>
        <div class="arch arch-back"></div>
        <div class="arch arch-front"></div>
        <span class="hero-note">Form &amp; function<br />in quiet balance</span>
      </div>
    </section>

    <section class="products-section" id="products" aria-labelledby="products-title">
      <div class="section-heading">
        <div><p class="eyebrow">Wybrane dla Ciebie</p><h2 id="products-title">Nasze produkty</h2></div>
        <p class="product-count"><span data-product-count>{products.length}</span> produktów</p>
      </div>

      {loadError ? (
        <div class="store-message" role="alert">
          <strong>Nie udało się połączyć ze sklepem.</strong>
          <span>{loadError} Uruchom Medusę i sprawdź konfigurację w <code>storefront/.env</code>.</span>
        </div>
      ) : products.length === 0 ? (
        <div class="store-message">
          <strong>Produkty pojawią się tu wkrótce.</strong>
          <span>Sprawdź, czy są opublikowane w kanale sprzedaży przypisanym do klucza API.</span>
        </div>
      ) : (
        <div class="product-grid">
          {products.map((product, index) => (
            <a class="product-card" href={`/products/${product.handle}`} data-product-card data-product-link data-categories={product.categories?.map((category) => category.id).join(",") || ""}>
              <div class="product-image-wrap">
                {product.thumbnail ? (
                  <img src={product.thumbnail} alt={product.title} class="product-image" loading={index < 4 ? "eager" : "lazy"} transition:name={`product-image-${product.id}`} />
                ) : (
                  <div class="image-placeholder" aria-hidden="true"><span>{product.title.charAt(0)}</span></div>
                )}
                <span class="product-number">{String(index + 1).padStart(2, "0")}</span>
              </div>
              <div class="product-info">
                <div>
                  <p class="product-category">{product.categories?.[0]?.name || "Kolekcja Atelier"}</p>
                  <h3>{product.title}</h3>
                </div>
                <p class="product-price">{formatProductPrice(product)}</p>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>
  </main>

  <footer>
    <a class="brand footer-brand" href="/"><span class="brand-mark">A</span><span>Atelier</span></a>
    <p>Przedmioty do dobrego życia.</p>
    <p>© 2026 Atelier</p>
  </footer>

</Layout>

<style>
  .site-header { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid rgba(32, 34, 31, 0.13); background: rgba(245, 243, 238, 0.88); backdrop-filter: blur(18px); }
  .nav-shell, .hero, .products-section, footer { width: min(1400px, calc(100% - 64px)); margin-inline: auto; }
  .nav-shell { min-height: 82px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 48px; }
  .brand { display: inline-flex; align-items: center; gap: 11px; color: inherit; font-family: Georgia, "Times New Roman", serif; font-size: 1.3rem; font-weight: 700; letter-spacing: -0.03em; text-decoration: none; }
  .brand-mark { width: 31px; height: 31px; display: grid; place-items: center; border-radius: 50%; color: #f5f3ee; background: #35503a; font-size: 0.9rem; }
  .category-menu { display: flex; justify-content: center; gap: 6px; overflow-x: auto; scrollbar-width: none; }
  .category-menu::-webkit-scrollbar { display: none; }
  .category-link { flex: 0 0 auto; padding: 9px 13px; border: 0; border-radius: 99px; color: #686b65; background: transparent; cursor: pointer; font-size: 0.82rem; transition: color 180ms ease, background 180ms ease; }
  .category-link:hover, .category-link.is-active { color: #fff; background: #35503a; }
  .hero { min-height: 650px; display: grid; grid-template-columns: 1.05fr 0.95fr; align-items: center; gap: 72px; padding-block: 70px; }
  .eyebrow { margin: 0 0 24px; color: #73776f; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; }
  h1, h2 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-weight: 400; letter-spacing: -0.055em; }
  h1 { max-width: 720px; font-size: clamp(4rem, 7.5vw, 7.7rem); line-height: 0.88; }
  h1 em { color: #867b5e; font-weight: 400; }
  .hero-description { max-width: 510px; margin: 36px 0 32px; color: #5f625d; font-size: 1rem; line-height: 1.75; }
  .primary-button { display: inline-flex; align-items: center; gap: 35px; padding: 16px 20px; color: #fff; background: #35503a; text-decoration: none; font-size: 0.82rem; font-weight: 700; transition: transform 180ms ease, background 180ms ease; }
  .primary-button:hover { transform: translateY(-2px); background: #263e2b; }
  .hero-art { position: relative; height: min(560px, 45vw); min-height: 410px; overflow: hidden; background: #d7d0c0; }
  .hero-art::after { content: ""; position: absolute; inset: 0; opacity: 0.13; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.45'/%3E%3C/svg%3E"); pointer-events: none; }
  .sun { position: absolute; top: 12%; right: 12%; width: 36%; aspect-ratio: 1; border-radius: 50%; background: #b86f4e; }
  .arch { position: absolute; bottom: -10%; border-radius: 48% 48% 0 0; }
  .arch-back { left: 8%; width: 57%; height: 72%; background: #69775e; transform: rotate(-6deg); }
  .arch-front { right: -5%; width: 58%; height: 61%; background: #9a8e70; transform: rotate(9deg); }
  .hero-note { position: absolute; z-index: 2; right: 6%; bottom: 5%; color: rgba(255, 255, 255, 0.86); font-family: Georgia, "Times New Roman", serif; font-size: 0.85rem; font-style: italic; line-height: 1.45; }
  .products-section { padding-block: 100px 120px; border-top: 1px solid rgba(32, 34, 31, 0.13); }
  .section-heading { display: flex; justify-content: space-between; align-items: end; margin-bottom: 40px; }
  .section-heading .eyebrow { margin-bottom: 12px; }
  h2 { font-size: clamp(2.8rem, 5vw, 4.8rem); }
  .product-count { margin: 0 0 8px; color: #73776f; font-size: 0.8rem; }
  .product-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .product-card { color: inherit; text-decoration: none; transition: opacity 180ms ease, transform 180ms ease; }
  .product-card:active { opacity: .82; transform: scale(.975); }
  .product-card[hidden] { display: none; }
  .product-image-wrap { position: relative; aspect-ratio: 0.82; overflow: hidden; background: #e7e2d8; }
  .product-image { width: 100%; height: 100%; object-fit: cover; transition: transform 500ms cubic-bezier(0.2, 0.75, 0.25, 1); }
  .product-card:hover .product-image { transform: scale(1.035); }
  .image-placeholder { width: 100%; height: 100%; display: grid; place-items: center; color: rgba(53, 80, 58, 0.28); background: linear-gradient(145deg, #dfd9cb, #eeeae2); font-family: Georgia, "Times New Roman", serif; font-size: 7rem; }
  .product-number { position: absolute; top: 14px; left: 14px; padding: 6px 8px; color: #fff; background: rgba(31, 34, 30, 0.48); backdrop-filter: blur(8px); font-size: 0.62rem; letter-spacing: 0.12em; }
  .product-info { display: flex; justify-content: space-between; gap: 12px; padding-top: 17px; }
  .product-category { margin: 0 0 6px; color: #858880; font-size: 0.65rem; letter-spacing: 0.11em; text-transform: uppercase; }
  .product-info h3 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: 1.15rem; font-weight: 400; }
  .product-price { flex: 0 0 auto; margin: 20px 0 0; color: #4f524d; font-size: 0.78rem; }
  .store-message { display: flex; flex-direction: column; gap: 8px; padding: 28px; border: 1px solid #d6d0c3; background: #ebe7de; line-height: 1.6; }
  .store-message span { color: #686b65; }
  footer { min-height: 180px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 20px; border-top: 1px solid rgba(32, 34, 31, 0.13); color: #6c6f69; font-size: 0.76rem; }
  footer p:last-child { justify-self: end; }
  .footer-brand { color: #20221f; }

  @media (max-width: 1050px) {
    .nav-shell { gap: 18px; }
    .category-menu { justify-content: start; }
    .hero { gap: 36px; }
    .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 760px) {
    .nav-shell, .hero, .products-section, footer { width: min(100% - 32px, 1400px); }
    .nav-shell { min-height: 70px; grid-template-columns: 1fr auto; }
    .category-menu { grid-column: 1 / -1; order: 3; width: calc(100vw - 16px); margin-left: -8px; padding: 0 8px 10px; }
    :global(.cart-link) { justify-self: end; }
    .hero { min-height: auto; grid-template-columns: 1fr; padding-block: 70px 48px; }
    h1 { font-size: clamp(3.5rem, 16vw, 5.6rem); }
    .hero-art { height: 110vw; max-height: 540px; }
    .products-section { padding-block: 72px 90px; }
    .product-grid { gap: 32px 14px; }
    .product-info { display: block; }
    .product-price { margin-top: 8px; }
    footer { min-height: 220px; grid-template-columns: 1fr; align-content: center; }
    footer p { margin: 0; }
    footer p:last-child { justify-self: start; }
  }

  @media (max-width: 480px) { .product-grid { grid-template-columns: 1fr; } .section-heading { align-items: start; gap: 20px; } }
</style>
